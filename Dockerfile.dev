# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm@sha256:d193c6f51a7dbd10395d6328de3a7edb0516fb0608ca138036576f574c3e07d2

COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/torchbase-dev-venv \
    PATH=/opt/torchbase-dev-venv/bin:$PATH \
    PYRIGHT_PYTHON_CACHE_DIR=/opt/pyright-cache

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libatomic1 \
    && rm --recursive --force /var/lib/apt/lists/*

WORKDIR /work

COPY requirements-dev.txt ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv "$VIRTUAL_ENV" \
    && uv pip install --python "$VIRTUAL_ENV/bin/python" --require-hashes -r requirements-dev.txt \
    && python -m pyright --version
